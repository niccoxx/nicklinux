# Configurazione della distro. Modifica qui nome e opzioni, poi lancia ./build.sh
DISTRO_NAME="NickLinux"
DISTRO_ID="nicklinux"
DISTRO_URL="https://github.com/niccoxx/nicklinux"

# Versione Fedora di base: "latest" = ultima stabile disponibile come immagine container
FEDORA_RELEASE="latest"

# Kernel:
#   vanilla = ultimo kernel stabile mainline da kernel.org (COPR @kernel-vanilla/stable)
#   fedora  = kernel Fedora (segue lo stable con qualche settimana di ritardo, firmato per Secure Boot)
KERNEL_SOURCE="vanilla"

ARCH="x86_64"
